<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Rasmus Tiiman - veebiprogrammeerimine</title>
</head>
<body>
	<img src="/media/veebiprogrammeerimine_2026_TA.png" alt="">
	<h1>Eesti filmid</h1>
	<p>Siin lehel on näha Eesti filme.</p>
	<hr>
	<ul>
		<li><a href="/">Avalehele</a></li>
		<li><a href="/eestifilm">Eesti filmi avaleht</a></li>
	</ul>
	<hr>
	<ol>
		<% movieList.forEach(function(movie){%>
		<li><%= movie.title %>, <%= movie.release_year %>, <%= movie.duration_minutes %> min<% if(movie.description){ %>. <%= movie.description %><% } %></li>
		<% }); %>
	</ol>
</body>
</html>