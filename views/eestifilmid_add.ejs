<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Rasmus Tiiman - veebiprogrammeerimine</title>
</head>
<body>
	<img src="/media/veebiprogrammeerimine_2026_TA.png" alt="">
	<h1>Eesti filmid</h1>
	<p>Siin lehel saab andmebaasi lisada Eesti filme.</p>
	<hr>
	<ul>
		<li><a href="/">Avalehele</a></li>
		<li><a href="/eestifilm">Eesti filmi avaleht</a></li>
	</ul>
	<hr>
	<form method="POST">
		<label for="titleInput">Filmi pealkiri</label>
		<input id="titleInput" name="titleInput" type="text" placeholder="Pealkiri ..." maxlength="100" value="<%= titleInput %>" required>
		<br>
		<label for="releaseYearInput">Valmimisaasta</label>
		<input id="releaseYearInput" name="releaseYearInput" type="number" min="1888" max="<%= new Date().getFullYear() %>" step="1" value="<%= releaseYearInput %>" required>
		<br>
		<label for="durationInput">Kestus minutites</label>
		<input id="durationInput" name="durationInput" type="number" min="1" max="1000" step="1" value="<%= durationInput %>" required>
		<br>
		<label for="descriptionInput">Kirjeldus (kuni 1000 märki)</label>
		<br>
		<textarea id="descriptionInput" name="descriptionInput" rows="5" cols="60" placeholder="Filmi lühikirjeldus ..."><%= descriptionInput %></textarea>
		<br>
		<input id="movieSubmit" name="movieSubmit" type="submit" value="Salvesta">
	</form>
	<p><%= notice %></p>
</body>
</html>